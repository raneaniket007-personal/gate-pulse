generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VisitorStatus {
  PENDING
  APPROVED
  DENIED
  EXPIRED
}

model Society {
  id      String @id @default(uuid())
  name    String
  address String

  gateLatitude        Decimal
  gateLongitude       Decimal
  allowedRadiusMeters Int     @default(50)

  flats    Flat[]
  visitors VisitorLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Flat {
  id String @id @default(uuid())

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  unitNumber   String
  residentName String
  phone        String

  visitors VisitorLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([societyId, unitNumber])
  @@index([societyId])
}

model VisitorLog {
  id String @id @default(uuid())

  societyId String
  society   Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  flatId String
  flat   Flat   @relation(fields: [flatId], references: [id], onDelete: Cascade)

  visitorName String

  photoKey String?

  latitude  Decimal?
  longitude Decimal?
  accuracy  Decimal?

  status VisitorStatus @default(PENDING)

  expiresAt DateTime?

  approvedAt DateTime?
  passExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([societyId, createdAt])
  @@index([flatId, createdAt])
  @@index([status])
}
